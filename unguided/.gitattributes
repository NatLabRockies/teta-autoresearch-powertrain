# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true

# Session transcripts are committed verbatim so a run is fully transparent.
# They are large, and a session snapshots them several times, so each version
# would otherwise be a whole new blob in the packfile. tools/new_tree.sh runs
# `git lfs install --local` in every tree it creates.
results/transcript-*/** filter=lfs diff=lfs merge=lfs -text
